@model EventEase.Models.Event
@{
    ViewData["Title"] = "Event Details";
}
<h2>Event Details</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Event Name</dt>
    <dd class="col-sm-9">@Model.EventName</dd>
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.EventDate.ToString("dd MMM yyyy HH:mm")</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>
    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue?.VenueName</dd>
    <dt class="col-sm-3">Event Type</dt>
    <dd class="col-sm-9">@Model.EventType?.TypeName</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to Events</a>