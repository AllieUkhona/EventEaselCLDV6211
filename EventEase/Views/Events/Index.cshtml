@model IEnumerable<EventEase.Models.Event>
@{
    ViewData["Title"] = "Events";
}
<h2>Events</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Add New Event</a>
<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr><th>Name</th><th>Date</th><th>Description</th><th>Venue</th><th>Type</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                <td>@item.Description</td>
                <td>@item.Venue?.VenueName</td>
                <td>@item.EventType?.TypeName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>