@model EventEase.Models.Booking
@{
    ViewData["Title"] = "Delete Booking";
}
<h2>Delete Booking</h2>
<hr />
<div class="alert alert-warning"><strong>Are you sure you want to delete this booking?</strong></div>
<dl class="row">
    <dt class="col-sm-3">Booking ID</dt>
    <dd class="col-sm-9">@Model.BookingId</dd>
    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">@Model.ClientName</dd>
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.BookingDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Event</dt>
    <dd class="col-sm-9">@Model.Event?.EventName</dd>
    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue?.VenueName</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BookingId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>